<Window x:Class="CustomVrsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CustomVrsEditor"
        Title="Custom Versification Editor"
        Height="720" Width="920"
        MinHeight="420" MinWidth="620"
        Closing="Window_Closing">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"
                        Executed="New_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Open"
                        Executed="Open_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="Save_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}"
                        Executed="SaveAs_Executed"
                        CanExecute="Always_CanExecute"/>
    </Window.CommandBindings>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Menu_File}">
                <MenuItem Header="{DynamicResource Menu_New}"    Command="ApplicationCommands.New"/>
                <MenuItem Header="{DynamicResource Menu_Open}"   Command="ApplicationCommands.Open"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Save}"   Command="ApplicationCommands.Save"/>
                <MenuItem Header="{DynamicResource Menu_SaveAs}" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Exit}" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Project identity bar -->
        <Border DockPanel.Dock="Top"
                Background="#E8EEF7"
                BorderBrush="#C3D2E8"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <TextBlock x:Name="ProjectHeaderText"
                       FontWeight="SemiBold"
                       FontSize="14"/>
        </Border>

        <!-- Restart reminder banner -->
        <Border DockPanel.Dock="Top"
                Background="#FFF3CD"
                BorderBrush="#FFEAA0"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <TextBlock Text="{DynamicResource Banner_RestartReminder}"
                       FontStyle="Italic"
                       Foreground="#856404"/>
        </Border>

        <!-- Language toolbar -->
        <Border DockPanel.Dock="Top"
                Background="#F5F5F5"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Toolbar_Language}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="LanguageCombo"
                          Width="130"
                          SelectionChanged="LanguageCombo_SelectionChanged"/>
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content -->
        <TabControl x:Name="MainTabs" Margin="4">

            <!-- Tab 1: Chapter/Verse Differences -->
            <TabItem Header="{DynamicResource Tab_ChapterDiffs}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              x:Name="ChapterDiffGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F8F8"
                              BorderThickness="0"
                              Margin="4,4,4,0"
                              PreviewKeyDown="ChapterDiffGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Book"
                                                 Binding="{Binding Book}"
                                                 IsReadOnly="True"
                                                 Width="90"/>
                            <DataGridTextColumn Header="Chapters"
                                                 Binding="{Binding ChaptersText}"
                                                 IsReadOnly="True"
                                                 Width="*"/>
                            <DataGridCheckBoxColumn Header="Disabled"
                                                     Binding="{Binding IsDisabled}"
                                                     Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Background="#EFEFEF"
                            BorderBrush="#D0D0D0"
                            BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource AddBar_Book}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="ChapterDiffBookCombo"
                                      Width="90"
                                      Margin="0,0,14,0"
                                      IsEditable="True"
                                      KeyDown="ChapterDiffInput_KeyDown"/>
                            <TextBlock Text="{DynamicResource AddBar_Chapter}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="ChapterBox"
                                     Width="60"
                                     Margin="0,0,14,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="ChapterDiffInput_KeyDown"/>
                            <TextBlock Text="{DynamicResource AddBar_MaxVerse}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="MaxVerseBox"
                                     Width="60"
                                     Margin="0,0,14,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="ChapterDiffInput_KeyDown"/>
                            <Button x:Name="AcceptChapterDiffBtn"
                                    Content="{DynamicResource Btn_Accept}"
                                    Width="80"
                                    Padding="0,3"
                                    Margin="0,0,6,0"
                                    Click="AcceptChapterDiff_Click"/>
                            <Button Content="{DynamicResource Btn_Delete}"
                                    Width="80"
                                    Padding="0,3"
                                    Click="DeleteChapterDiff_Click"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Mapping -->
            <TabItem Header="{DynamicResource Tab_Mapping}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              x:Name="MappingGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F8F8"
                              BorderThickness="0"
                              Margin="4,4,4,0"
                              PreviewKeyDown="MappingGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="From"
                                                 Binding="{Binding FromRef, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="150"/>
                            <DataGridTextColumn Header="To"
                                                 Binding="{Binding ToRef, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="150"/>
                            <DataGridCheckBoxColumn Header="Disabled"
                                                     Binding="{Binding IsDisabled}"
                                                     Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Background="#EFEFEF"
                            BorderBrush="#D0D0D0"
                            BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource AddBar_From}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource AddBar_Book}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="FromBookCombo"
                                      Width="80"
                                      Margin="0,0,10,0"
                                      IsEditable="True"
                                      KeyDown="MappingInput_KeyDown"/>
                            <TextBlock Text="{DynamicResource AddBar_Chapter}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="FromChapterBox"
                                     Width="45"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MappingInput_KeyDown"/>
                            <TextBlock Text="{DynamicResource AddBar_Verse}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="FromVerseBox"
                                     Width="45"
                                     Margin="0,0,4,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MappingInput_KeyDown"/>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="FromVerseEndBox"
                                     Width="45"
                                     Margin="0,0,18,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MappingInput_KeyDown"/>

                            <TextBlock Text="{DynamicResource AddBar_To}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource AddBar_Book}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="ToBookCombo"
                                      Width="80"
                                      Margin="0,0,10,0"
                                      IsEditable="True"
                                      KeyDown="MappingInput_KeyDown"/>
                            <TextBlock Text="{DynamicResource AddBar_Chapter}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="ToChapterBox"
                                     Width="45"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MappingInput_KeyDown"/>
                            <TextBlock Text="{DynamicResource AddBar_Verse}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="ToVerseBox"
                                     Width="45"
                                     Margin="0,0,4,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MappingInput_KeyDown"/>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="ToVerseEndBox"
                                     Width="45"
                                     Margin="0,0,18,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MappingInput_KeyDown"/>

                            <Button x:Name="AcceptMappingBtn"
                                    Content="{DynamicResource Btn_Accept}"
                                    Width="80"
                                    Padding="0,3"
                                    Margin="0,0,6,0"
                                    Click="AcceptMapping_Click"/>
                            <Button Content="{DynamicResource Btn_Delete}"
                                    Width="80"
                                    Padding="0,3"
                                    Click="DeleteMapping_Click"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Missing Verses -->
            <TabItem Header="{DynamicResource Tab_MissingVerses}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              x:Name="MissingVerseGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F8F8"
                              BorderThickness="0"
                              Margin="4,4,4,0"
                              PreviewKeyDown="MissingVerseGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Verse"
                                                 Binding="{Binding VerseRef, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="*"/>
                            <DataGridCheckBoxColumn Header="Disabled"
                                                     Binding="{Binding IsDisabled}"
                                                     Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Background="#EFEFEF"
                            BorderBrush="#D0D0D0"
                            BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource AddBar_Book}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="MissingBookCombo"
                                      Width="80"
                                      Margin="0,0,14,0"
                                      IsEditable="True"
                                      KeyDown="MissingVerseInput_KeyDown"/>
                            <TextBlock Text="{DynamicResource AddBar_Chapter}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="MissingChapterBox"
                                     Width="45"
                                     Margin="0,0,14,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MissingVerseInput_KeyDown"/>
                            <TextBlock Text="{DynamicResource AddBar_Verse}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="MissingVerseBox"
                                     Width="45"
                                     Margin="0,0,4,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MissingVerseInput_KeyDown"/>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="MissingVerseEndBox"
                                     Width="45"
                                     Margin="0,0,14,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MissingVerseInput_KeyDown"/>
                            <Button x:Name="AcceptMissingBtn"
                                    Content="{DynamicResource Btn_Accept}"
                                    Width="80"
                                    Padding="0,3"
                                    Margin="0,0,6,0"
                                    Click="AcceptMissingVerse_Click"/>
                            <Button Content="{DynamicResource Btn_Delete}"
                                    Width="80"
                                    Padding="0,3"
                                    Click="DeleteMissingVerse_Click"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
