<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_Fichier</sys:String>
    <sys:String x:Key="Menu_New">_Nouveau</sys:String>
    <sys:String x:Key="Menu_Open">_Ouvrir…</sys:String>
    <sys:String x:Key="Menu_Save">_Enregistrer</sys:String>
    <sys:String x:Key="Menu_SaveAs">Enregistrer _sous…</sys:String>
    <sys:String x:Key="Menu_Exit">_Quitter</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Language">Langue :</sys:String>

    <!-- Project bar / banner -->
    <sys:String x:Key="ProjectBar_Format">Projet : {0}</sys:String>
    <sys:String x:Key="ProjectBar_FormatWithVersification">Projet : {0} utilise la versification {1}</sys:String>
    <sys:String x:Key="Banner_RestartReminder">N'oubliez pas de redémarrer Paratext après avoir enregistré des modifications dans custom.vrs.</sys:String>

    <!-- Tabs -->
    <sys:String x:Key="Tab_ChapterDiffs">Différences de chapitre/verset</sys:String>
    <sys:String x:Key="Tab_Mapping">Correspondances</sys:String>
    <sys:String x:Key="Tab_MissingVerses">Versets manquants</sys:String>

    <!-- DataGrid columns (used from code-behind) -->
    <sys:String x:Key="Column_Book">Livre</sys:String>
    <sys:String x:Key="Column_Chapters">Chapitres</sys:String>
    <sys:String x:Key="Column_FromRef">De</sys:String>
    <sys:String x:Key="Column_ToRef">À</sys:String>
    <sys:String x:Key="Column_VerseRef">Verset</sys:String>
    <sys:String x:Key="Column_Disabled">Désactivé</sys:String>

    <!-- Add bars -->
    <sys:String x:Key="AddBar_Book">Livre :</sys:String>
    <sys:String x:Key="AddBar_Chapter">Chapitre :</sys:String>
    <sys:String x:Key="AddBar_MaxVerse">Verset maximum :</sys:String>
    <sys:String x:Key="AddBar_From">De :</sys:String>
    <sys:String x:Key="AddBar_To">À :</sys:String>
    <sys:String x:Key="AddBar_Verse">Verset :</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Accept">Accepter</sys:String>
    <sys:String x:Key="Btn_Delete">Supprimer</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">Éditeur de Versification Personnalisée</sys:String>
    <sys:String x:Key="Status_Unsaved">(non enregistré)</sys:String>
    <sys:String x:Key="Status_SummaryFormat">{0} différences, {1} correspondances, {2} versets manquants</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Erreur d'enregistrement</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">Impossible d'enregistrer le fichier :</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Modifications non enregistrées</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">Des modifications ne sont pas enregistrées. Enregistrer avant de continuer ?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Ouvrir un fichier de versification</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Enregistrer le fichier de versification</sys:String>

</ResourceDictionary>
