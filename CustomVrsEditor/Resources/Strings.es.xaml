<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_Archivo</sys:String>
    <sys:String x:Key="Menu_New">_Nuevo</sys:String>
    <sys:String x:Key="Menu_Open">_Abrir…</sys:String>
    <sys:String x:Key="Menu_Save">_Guardar</sys:String>
    <sys:String x:Key="Menu_SaveAs">Guardar _como…</sys:String>
    <sys:String x:Key="Menu_Exit">_Salir</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Language">Idioma:</sys:String>

    <!-- Project bar / banner -->
    <sys:String x:Key="ProjectBar_Format">Proyecto: {0}</sys:String>
    <sys:String x:Key="ProjectBar_FormatWithVersification">Proyecto: {0} usa la versificación {1}</sys:String>
    <sys:String x:Key="Banner_RestartReminder">Recuerde reiniciar Paratext después de guardar cambios en custom.vrs.</sys:String>

    <!-- Tabs -->
    <sys:String x:Key="Tab_ChapterDiffs">Diferencias de capítulo/versículo</sys:String>
    <sys:String x:Key="Tab_Mapping">Correspondencias</sys:String>
    <sys:String x:Key="Tab_MissingVerses">Versículos faltantes</sys:String>

    <!-- DataGrid columns (used from code-behind) -->
    <sys:String x:Key="Column_Book">Libro</sys:String>
    <sys:String x:Key="Column_Chapters">Capítulos</sys:String>
    <sys:String x:Key="Column_FromRef">Desde</sys:String>
    <sys:String x:Key="Column_ToRef">Hasta</sys:String>
    <sys:String x:Key="Column_VerseRef">Versículo</sys:String>
    <sys:String x:Key="Column_Disabled">Deshabilitado</sys:String>

    <!-- Add bars -->
    <sys:String x:Key="AddBar_Book">Libro:</sys:String>
    <sys:String x:Key="AddBar_Chapter">Capítulo:</sys:String>
    <sys:String x:Key="AddBar_MaxVerse">Versículo máximo:</sys:String>
    <sys:String x:Key="AddBar_From">Desde:</sys:String>
    <sys:String x:Key="AddBar_To">Hasta:</sys:String>
    <sys:String x:Key="AddBar_Verse">Versículo:</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Accept">Aceptar</sys:String>
    <sys:String x:Key="Btn_Delete">Eliminar</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">Editor de Versificación Personalizada</sys:String>
    <sys:String x:Key="Status_Unsaved">(sin guardar)</sys:String>
    <sys:String x:Key="Status_SummaryFormat">{0} diferencias, {1} correspondencias, {2} versículos faltantes</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Error al guardar</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">No se pudo guardar el archivo:</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Cambios sin guardar</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">Hay cambios sin guardar. ¿Guardar antes de continuar?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Abrir archivo de versificación</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Guardar archivo de versificación</sys:String>

</ResourceDictionary>
