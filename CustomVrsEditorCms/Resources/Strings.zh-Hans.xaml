<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">文件(_F)</sys:String>
    <sys:String x:Key="Menu_New">新建(_N)</sys:String>
    <sys:String x:Key="Menu_Open">打开(_O)…</sys:String>
    <sys:String x:Key="Menu_Save">保存(_S)</sys:String>
    <sys:String x:Key="Menu_SaveAs">另存为(_A)…</sys:String>
    <sys:String x:Key="Menu_Exit">退出(_X)</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Language">语言：</sys:String>

    <!-- Project bar / banner -->
    <sys:String x:Key="ProjectBar_Format">项目：{0}</sys:String>
    <sys:String x:Key="ProjectBar_FormatWithVersification">项目：{0} 使用 {1} 版本编排</sys:String>
    <sys:String x:Key="Banner_RestartReminder">保存对 custom.vrs 的更改后，请记得重启 Paratext。</sys:String>

    <!-- Tabs -->
    <sys:String x:Key="Tab_ChapterDiffs">章节/经文差异</sys:String>
    <sys:String x:Key="Tab_Mapping">对照映射</sys:String>
    <sys:String x:Key="Tab_MissingVerses">缺失经文</sys:String>

    <!-- DataGrid columns (used from code-behind) -->
    <sys:String x:Key="Column_Book">书卷</sys:String>
    <sys:String x:Key="Column_Chapters">章节</sys:String>
    <sys:String x:Key="Column_FromRef">起始</sys:String>
    <sys:String x:Key="Column_ToRef">目标</sys:String>
    <sys:String x:Key="Column_VerseRef">经文</sys:String>
    <sys:String x:Key="Column_Disabled">禁用</sys:String>

    <!-- Add bars -->
    <sys:String x:Key="AddBar_Book">书卷：</sys:String>
    <sys:String x:Key="AddBar_Chapter">章：</sys:String>
    <sys:String x:Key="AddBar_MaxVerse">最大节数：</sys:String>
    <sys:String x:Key="AddBar_From">起始：</sys:String>
    <sys:String x:Key="AddBar_To">目标：</sys:String>
    <sys:String x:Key="AddBar_Verse">节：</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Accept">接受</sys:String>
    <sys:String x:Key="Btn_Delete">删除</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">自定义版本编排编辑器</sys:String>
    <sys:String x:Key="Status_Unsaved">（未保存）</sys:String>
    <sys:String x:Key="Status_SummaryFormat">{0} 项差异，{1} 项映射，{2} 项缺失经文</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">保存错误</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">无法保存文件：</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">未保存的更改</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">有未保存的更改。是否在继续之前保存？</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">打开版本编排文件</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">保存版本编排文件</sys:String>

</ResourceDictionary>
