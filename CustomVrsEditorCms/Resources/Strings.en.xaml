<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_File</sys:String>
    <sys:String x:Key="Menu_New">_New</sys:String>
    <sys:String x:Key="Menu_Open">_Open…</sys:String>
    <sys:String x:Key="Menu_Save">_Save</sys:String>
    <sys:String x:Key="Menu_SaveAs">Save _As…</sys:String>
    <sys:String x:Key="Menu_Exit">E_xit</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Language">Language:</sys:String>

    <!-- Project bar / banner -->
    <sys:String x:Key="ProjectBar_Format">Project: {0}</sys:String>
    <sys:String x:Key="ProjectBar_FormatWithVersification">Project: {0} uses the {1} versification</sys:String>
    <sys:String x:Key="Banner_RestartReminder">Remember to restart Paratext after saving changes to custom.vrs.</sys:String>

    <!-- Tabs -->
    <sys:String x:Key="Tab_ChapterDiffs">Chapter/Verse Differences</sys:String>
    <sys:String x:Key="Tab_Mapping">Mapping</sys:String>
    <sys:String x:Key="Tab_MissingVerses">Missing Verses</sys:String>

    <!-- DataGrid columns (used from code-behind) -->
    <sys:String x:Key="Column_Book">Book</sys:String>
    <sys:String x:Key="Column_Chapters">Chapters</sys:String>
    <sys:String x:Key="Column_FromRef">From</sys:String>
    <sys:String x:Key="Column_ToRef">To</sys:String>
    <sys:String x:Key="Column_VerseRef">Verse</sys:String>
    <sys:String x:Key="Column_Disabled">Disabled</sys:String>

    <!-- Add bars -->
    <sys:String x:Key="AddBar_Book">Book:</sys:String>
    <sys:String x:Key="AddBar_Chapter">Chapter:</sys:String>
    <sys:String x:Key="AddBar_MaxVerse">Max verse:</sys:String>
    <sys:String x:Key="AddBar_From">From:</sys:String>
    <sys:String x:Key="AddBar_To">To:</sys:String>
    <sys:String x:Key="AddBar_Verse">Verse:</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Accept">Accept</sys:String>
    <sys:String x:Key="Btn_Delete">Delete</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">Custom Versification Editor</sys:String>
    <sys:String x:Key="Status_Unsaved">(unsaved)</sys:String>
    <sys:String x:Key="Status_SummaryFormat">{0} chapter diffs, {1} mappings, {2} missing verses</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Save Error</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">Could not save file:</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Unsaved Changes</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">There are unsaved changes. Save before continuing?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Open Versification File</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Save Versification File</sys:String>

</ResourceDictionary>
