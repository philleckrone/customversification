<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_Arquivo</sys:String>
    <sys:String x:Key="Menu_New">_Novo</sys:String>
    <sys:String x:Key="Menu_Open">_Abrir…</sys:String>
    <sys:String x:Key="Menu_Save">_Salvar</sys:String>
    <sys:String x:Key="Menu_SaveAs">Salvar _como…</sys:String>
    <sys:String x:Key="Menu_Exit">Sai_r</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Language">Idioma:</sys:String>

    <!-- Project bar / banner -->
    <sys:String x:Key="ProjectBar_Format">Projeto: {0}</sys:String>
    <sys:String x:Key="ProjectBar_FormatWithVersification">Projeto: {0} usa a versificação {1}</sys:String>
    <sys:String x:Key="Banner_RestartReminder">Lembre-se de reiniciar o Paratext após salvar alterações no custom.vrs.</sys:String>

    <!-- Tabs -->
    <sys:String x:Key="Tab_ChapterDiffs">Diferenças de capítulo/versículo</sys:String>
    <sys:String x:Key="Tab_Mapping">Correspondências</sys:String>
    <sys:String x:Key="Tab_MissingVerses">Versículos ausentes</sys:String>

    <!-- DataGrid columns (used from code-behind) -->
    <sys:String x:Key="Column_Book">Livro</sys:String>
    <sys:String x:Key="Column_Chapters">Capítulos</sys:String>
    <sys:String x:Key="Column_FromRef">De</sys:String>
    <sys:String x:Key="Column_ToRef">Para</sys:String>
    <sys:String x:Key="Column_VerseRef">Versículo</sys:String>
    <sys:String x:Key="Column_Disabled">Desativado</sys:String>

    <!-- Add bars -->
    <sys:String x:Key="AddBar_Book">Livro:</sys:String>
    <sys:String x:Key="AddBar_Chapter">Capítulo:</sys:String>
    <sys:String x:Key="AddBar_MaxVerse">Versículo máximo:</sys:String>
    <sys:String x:Key="AddBar_From">De:</sys:String>
    <sys:String x:Key="AddBar_To">Para:</sys:String>
    <sys:String x:Key="AddBar_Verse">Versículo:</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Accept">Aceitar</sys:String>
    <sys:String x:Key="Btn_Delete">Excluir</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">Editor de Versificação Personalizada</sys:String>
    <sys:String x:Key="Status_Unsaved">(não salvo)</sys:String>
    <sys:String x:Key="Status_SummaryFormat">{0} diferenças, {1} correspondências, {2} versículos ausentes</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Erro ao salvar</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">Não foi possível salvar o arquivo:</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Alterações não salvas</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">Há alterações não salvas. Salvar antes de continuar?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Abrir arquivo de versificação</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Salvar arquivo de versificação</sys:String>

</ResourceDictionary>
